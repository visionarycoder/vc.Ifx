<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>vc.Ifx.Filtering.EntityFrameworkCore</PackageId>
    <Description>Entity Framework Core integration for vc.Ifx filters.</Description>
    <PackageTags>filtering;entityframeworkcore;queries;ifx</PackageTags>
    <RepositoryUrl>https://github.com/visionarycoder/vc.Ifx</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\vc.Ifx.Filtering\vc.Ifx.Filtering.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
