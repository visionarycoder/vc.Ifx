<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <PackageId>Ifx.Roslyn</PackageId>
    <Description>Shared diagnostic contracts and architecture models for Ifx compiler tooling.</Description>
    <PackageTags>ifx;roslyn;diagnostics;contracts</PackageTags>
    <RepositoryUrl>https://github.com/visionarycoder/vc.Ifx</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Common" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <AdditionalFiles Include="Diagnostics/AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="Diagnostics/AnalyzerReleases.Unshipped.md" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
