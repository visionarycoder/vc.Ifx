<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Target Framework -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- Language Features -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Build Output -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Code Analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Source Link -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Package Identity -->
    <PackageId>VisionaryCoder.Framework.Resilience</PackageId>
    <Version>1.0.0</Version>
    <Authors>VisionaryCoder</Authors>
    <Company>VisionaryCoder</Company>
    <Product>VisionaryCoder Framework Resilience</Product>

    <!-- Package Metadata -->
    <Title>VisionaryCoder.Framework.Resilience</Title>
    <Description>Resilience patterns for VisionaryCoder Framework including Polly-based retry policies, circuit breakers, rate limiting, bulkheads, health checks, and resilience interceptors. Built on .NET 10 LTS.</Description>
    <PackageTags>framework;resilience;polly;retry;circuit-breaker;rate-limiting;health-checks;fault-tolerance;net10;lts</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>v1.0.0: Initial release with resilience patterns extracted from VisionaryCoder.Framework v2.0.0</PackageReleaseNotes>

    <!-- Repository Information -->
    <RepositoryUrl>https://github.com/visionarycoder/Framework</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup Label="Project References">
    <ProjectReference Include="..\VisionaryCoder.Framework.Abstractions\Framework.Abstractions.csproj" />
    <ProjectReference Include="..\VisionaryCoder.Framework.Patterns\Framework.Patterns.csproj" />
  </ItemGroup>

  <!-- Polly Resilience -->
  <ItemGroup Label="Polly">
    <PackageReference Include="Polly.Caching.Memory" />
    <PackageReference Include="Polly.Caching.MemoryCache" />
    <PackageReference Include="Polly.Contrib.WaitAndRetry" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="Polly.Extensions" />
    <PackageReference Include="Polly.Extensions.Http" />
    <PackageReference Include="Polly.RateLimiting" />
  </ItemGroup>

  <!-- Microsoft Extensions -->
  <ItemGroup Label="Microsoft Extensions">
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>

  <!-- Health Checks -->
  <ItemGroup Label="HealthChecks">
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
  </ItemGroup>

  <!-- Development Tools -->
  <ItemGroup Label="Development">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <!-- Framework References -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
