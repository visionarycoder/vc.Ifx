<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageId>VisionaryCoder.Framework.Storage</PackageId>
    <Version>1.0.0</Version>
    <Authors>VisionaryCoder</Authors>
    <Company>VisionaryCoder</Company>
    <Product>VisionaryCoder Framework Storage</Product>
    <Title>VisionaryCoder.Framework.Storage</Title>
    <Description>File and blob storage domain abstractions and implementations for VisionaryCoder Framework. Includes Azure Blob Storage, local file system, and FTP. Technology-agnostic storage patterns with pluggable providers. Built on .NET 10 LTS.</Description>
    <PackageTags>framework;storage;blob;files;azure;ftp;local;domain;net10;lts</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>v1.0.0: Initial release with storage domain extracted from technology-specific packages</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/visionarycoder/Framework</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Label="Project References">
    <ProjectReference Include="..\Framework.Abstractions\Framework.Abstractions.csproj" />
    <ProjectReference Include="..\Framework.Storage.Abstractions\Framework.Storage.Abstractions.csproj" />
    <ProjectReference Include="..\Framework.Core\Framework.Core.csproj" />
  </ItemGroup>

  <ItemGroup Label="Azure Storage">
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Storage.Blobs" />
  </ItemGroup>

  <ItemGroup Label="FTP/SFTP">
    <PackageReference Include="FluentFTP" />
    <PackageReference Include="SSH.NET" />
  </ItemGroup>

  <ItemGroup Label="HealthChecks">
    <PackageReference Include="AspNetCore.HealthChecks.Azure.Storage.Blobs" />
  </ItemGroup>

  <ItemGroup Label="Development">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>
