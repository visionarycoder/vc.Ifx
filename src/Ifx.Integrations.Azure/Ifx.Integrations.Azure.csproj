<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Ifx.Integrations.Azure</PackageId>
    <Description>Ifx.Integrations.Azure platform adapters.</Description>
    <PackageTags>ifx;integrations;azure</PackageTags>
    <RepositoryUrl>https://github.com/visionarycoder/vc.Ifx</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Ifx.Integrations/Ifx.Integrations.csproj" />
    <PackageReference Include="Azure.Core" />
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Azure.Storage.Queues" />
    <PackageReference Include="Microsoft.Extensions.Configuration.AzureAppConfiguration" />
    <None Update="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Ifx.Archiving.GZip.UnitTests" />
    <InternalsVisibleTo Include="Ifx.Archiving.SevenZip.UnitTests" />
    <InternalsVisibleTo Include="Ifx.Messaging.Azure.ServiceBus.UnitTests" />
    <InternalsVisibleTo Include="Ifx.Messaging.Msmq.UnitTests" />
    <InternalsVisibleTo Include="Ifx.Messaging.ProviderSupport.UnitTests" />
    <InternalsVisibleTo Include="Ifx.Messaging.RabbitMQ.UnitTests" />
    <InternalsVisibleTo Include="Ifx.UnitTests" />
    <InternalsVisibleTo Include="Ifx.IntegrationTests" />
  </ItemGroup>
</Project>
