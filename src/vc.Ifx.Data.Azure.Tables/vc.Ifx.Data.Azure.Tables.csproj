<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>vc.Ifx.Data.Azure.Tables</PackageId>
    <Description>Azure Table Storage data access for vc.Ifx applications.</Description>
    <PackageTags>azure;tables;data;ifx</PackageTags>
    <RepositoryUrl>https://github.com/visionarycoder/vc.Ifx</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\vc.Ifx.Abstractions\vc.Ifx.Abstractions.csproj" />
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
