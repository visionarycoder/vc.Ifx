<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>vc.Ifx.Abstractions</PackageId>
    <Description>Foundational service results, correlation, and framework contracts for vc.Ifx.</Description>
    <PackageTags>framework;abstractions;contracts;ifx</PackageTags>
    <RepositoryUrl>https://github.com/visionarycoder/vc.Ifx</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
