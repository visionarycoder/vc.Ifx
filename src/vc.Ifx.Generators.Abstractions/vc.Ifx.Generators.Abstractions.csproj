<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>vc.Ifx.Generators.Abstractions</PackageId>
    <Description>Passive marker attributes and contracts consumed by vc.Ifx source generators.</Description>
    <PackageTags>abstractions;attributes;source-generation;ifx</PackageTags>
    <RepositoryUrl>https://github.com/visionarycoder/vc.Ifx</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
