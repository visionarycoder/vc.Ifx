<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Ifx.Observability</PackageId>
    <Description>Tracing and metrics integration for vc.Ifx request pipelines.</Description>
    <PackageTags>observability;tracing;metrics;ifx</PackageTags>
    <RepositoryUrl>https://github.com/visionarycoder/vc.Ifx</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ifx.Pipeline\Ifx.Pipeline.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
