<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Target Framework -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- Language Features -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
    <!-- Build Output -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- Package Identity -->
    <PackageId>Ifx</PackageId>
    <Authors>Ivan</Authors>
    <Company>VisionaryCoder / PraetorNexus</Company>
    <Product>vc.Ifx</Product>
    <!-- Package Metadata -->
    <Title>vc.Ifx Framework Library</Title>
    <Description>Core framework library providing foundational features and utilities for enterprise .NET applications.</Description>
    <PackageTags>framework;core;library;microsoft;patterns;ifx</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See CHANGELOG.md or GitHub releases for detailed release notes.</PackageReleaseNotes>
    <!-- Repository Information -->
    <RepositoryUrl>https://github.com/visionarycoder/vc.Ifx</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Data\Azure\NewFolder\**" />
    <EmbeddedResource Remove="Data\Azure\NewFolder\**" />
    <None Remove="Data\Azure\NewFolder\**" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="**/Sample/**/*.cs" />
    <InternalsVisibleTo Include="Ifx.Integrations" />
    <EmbeddedResource Include="../../.json/schemas/queryfilter.schema.json" LogicalName="Ifx.Schemas.queryfilter.schema.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <Compile Include="../Ifx.Roslyn.Generators/Attributes/*.cs" Link="Generators/Attributes/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
