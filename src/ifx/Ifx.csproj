<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Target Framework -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <!-- Language Features -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
    <!-- Build Output -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- Package Identity -->
    <PackageId>Ifx</PackageId>
    <Authors>Ivan</Authors>
    <Company>VisionaryCoder / PraetorNexus</Company>
    <Product>vc.Ifx</Product>
    <!-- Package Metadata -->
    <Title>vc.Ifx Framework Library</Title>
    <Description>Core framework and provider integrations for enterprise .NET applications.</Description>
    <PackageTags>framework;core;integrations;azure;windows;library;patterns;ifx</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See CHANGELOG.md or GitHub releases for detailed release notes.</PackageReleaseNotes>
    <!-- Repository Information -->
    <RepositoryUrl>https://github.com/visionarycoder/vc.Ifx</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Data\Azure\NewFolder\**" />
    <EmbeddedResource Remove="Data\Azure\NewFolder\**" />
    <None Remove="Data\Azure\NewFolder\**" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="FluentFTP" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="Polly.RateLimiting" />
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Azure.Core" />
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Azure.Storage.Queues" />
    <PackageReference Include="Microsoft.Extensions.Configuration.AzureAppConfiguration" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="../Ifx.Integrations/**/*.cs" Exclude="../Ifx.Integrations/**/Sample/**/*.cs;../Ifx.Integrations/**/bin/**/*.cs;../Ifx.Integrations/**/obj/**/*.cs" />
    <Compile Include="../Ifx.Integrations.Azure/**/*.cs" Exclude="../Ifx.Integrations.Azure/**/Sample/**/*.cs;../Ifx.Integrations.Azure/**/bin/**/*.cs;../Ifx.Integrations.Azure/**/obj/**/*.cs" />
    <Protobuf Include="../Ifx.Integrations/Transport/Grpc/Dispatch/GenericInvoker.proto" GrpcServices="Both" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Compile Include="../Ifx.Integrations.Windows/**/*.cs" Exclude="../Ifx.Integrations.Windows/**/Sample/**/*.cs;../Ifx.Integrations.Windows/**/bin/**/*.cs;../Ifx.Integrations.Windows/**/obj/**/*.cs" />
    <PackageReference Include="Experimental.System.Messaging" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="**/Sample/**/*.cs" />
    <InternalsVisibleTo Include="Ifx.Archiving.GZip.UnitTests" />
    <InternalsVisibleTo Include="Ifx.Archiving.SevenZip.UnitTests" />
    <InternalsVisibleTo Include="Ifx.Messaging.Azure.ServiceBus.UnitTests" />
    <InternalsVisibleTo Include="Ifx.Messaging.Msmq.UnitTests" />
    <InternalsVisibleTo Include="Ifx.Messaging.ProviderSupport.UnitTests" />
    <InternalsVisibleTo Include="Ifx.Messaging.RabbitMQ.UnitTests" />
    <EmbeddedResource Include="../../.json/schemas/queryfilter.schema.json" LogicalName="Ifx.Schemas.queryfilter.schema.json" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Ifx.Roslyn.Generators/Attributes/*.cs" Link="Generators/Attributes/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
