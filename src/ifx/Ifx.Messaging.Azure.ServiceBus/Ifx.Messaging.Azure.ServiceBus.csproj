<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Ifx.Messaging.Azure.ServiceBus</PackageId>
    <Description>Azure Service Bus messaging provider for Ifx.</Description>
    <PackageTags>ifx;messaging;azure;service-bus</PackageTags>
    <RepositoryUrl>https://github.com/visionarycoder/vc.Ifx</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Ifx.Messaging.Abstractions/Ifx.Messaging.Abstractions.csproj" />
    <ProjectReference Include="../Ifx.Messaging.ProviderSupport/Ifx.Messaging.ProviderSupport.csproj" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
