<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Ifx.Archiving.Tar</PackageId>
    <Description>TAR archive provider for Ifx.Archiving.</Description>
    <PackageTags>ifx;archiving;archive;tar</PackageTags>
    <RepositoryUrl>https://github.com/visionarycoder/vc.Ifx</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ifx.Archiving.Abstractions\Ifx.Archiving.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
