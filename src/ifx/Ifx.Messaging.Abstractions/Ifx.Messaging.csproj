<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Ifx.Messaging.Abstractions</PackageId>
    <AssemblyName>Ifx.Messaging.Abstractions</AssemblyName>
    <RootNamespace>Ifx.Messaging.Abstractions</RootNamespace>
    <Description>Provider-neutral message, publisher, consumer, and bus contracts for Ifx.</Description>
    <PackageTags>messaging;abstractions;contracts;ifx</PackageTags>
    <RepositoryUrl>https://github.com/visionarycoder/vc.Ifx</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
