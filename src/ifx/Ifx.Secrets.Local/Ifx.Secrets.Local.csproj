<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Ifx.Secrets.Local</PackageId>
    <Description>Configuration-backed secret retrieval for vc.Ifx.</Description>
    <PackageTags>configuration;secrets;local;ifx</PackageTags>
    <RepositoryUrl>https://github.com/visionarycoder/vc.Ifx</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ifx.Secrets\Ifx.Secrets.csproj" />
    <ProjectReference Include="..\Ifx.Secrets.Azure.KeyVault\Ifx.Secrets.Azure.KeyVault.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
