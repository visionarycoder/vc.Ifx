<Project>
  <!-- Opt-in package verification while other project workstreams are in flight. -->
  <Target Name="SelectSecretsAbstractionsReferences"
          BeforeTargets="AssignProjectConfiguration"
          Condition="'$(MSBuildProjectName)' == 'vc.Ifx.UnitTests'">
    <ItemGroup>
      <ProjectReference Remove="@(ProjectReference)"
                        Condition="'%(ProjectReference.Filename)' != 'vc.Ifx.Secrets.Abstractions'" />
    </ItemGroup>
  </Target>
  <Target Name="SelectSecretsAbstractionsTests"
          BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' == 'vc.Ifx.UnitTests'">
    <ItemGroup>
      <Compile Remove="@(Compile)" />
      <Compile Include="$(MSBuildThisFileDirectory)*Tests.cs" />
      <Compile Include="$(MSBuildProjectDirectory)/Usings.cs" />
      <Compile Include="$(IntermediateOutputPath)*.cs" />
      <Compile Include="$(GeneratedProgramFile)" Condition="'$(GeneratedProgramFile)' != ''" />
    </ItemGroup>
  </Target>
</Project>
