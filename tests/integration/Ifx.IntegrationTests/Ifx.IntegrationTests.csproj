<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Ifx.IntegrationTests</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Disable Roslyn/.NET analyzers for test project -->
    <RunAnalyzers>false</RunAnalyzers>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>false</RunAnalyzersDuringLiveAnalysis>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\..\src\ifx\Ifx.Analyzers\Ifx.Analyzers.csproj" />
    <ProjectReference Include="..\..\..\src\ifx\Ifx.CodeFixes\Ifx.CodeFixes.csproj" />
    <ProjectReference Include="..\..\..\src\ifx\Ifx.Filtering\Ifx.Filtering.csproj" />
    <ProjectReference Include="..\..\..\src\ifx\Ifx.Filtering.EntityFrameworkCore\Ifx.Filtering.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\..\src\ifx\Ifx.Generators.Abstractions\Ifx.Generators.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\src\ifx\Ifx.Proxy\Ifx.Proxy.csproj" />
    <ProjectReference Include="..\..\..\src\ifx\Ifx.Proxy.AspNetCore\Ifx.Proxy.AspNetCore.csproj" />
    <ProjectReference Include="..\..\..\src\ifx\Ifx.Proxy.Http\Ifx.Proxy.Http.csproj" />
    <ProjectReference Include="..\..\..\src\ifx\Ifx.Proxy.Interceptor\Ifx.Proxy.Interceptor.csproj" />
    <ProjectReference Include="..\..\..\src\ifx\Ifx.Roslyn\Ifx.Roslyn.csproj" />
    <ProjectReference Include="..\..\..\src\ifx\Ifx.Roslyn.Reporting\Ifx.Roslyn.Reporting.csproj" />
    <ProjectReference Include="..\..\..\src\ifx\Ifx.Secrets.Local\Ifx.Secrets.Local.csproj" />
    <ProjectReference Include="..\..\..\src\ifx\Ifx.Storage.Local\Ifx.Storage.Local.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="coverlet.msbuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

</Project>
