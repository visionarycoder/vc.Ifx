{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/vbd/evidence-manifest.schema.json",
  "title": "VBD Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "solution",
    "sourceRevision",
    "createdAtUtc",
    "includeRules",
    "excludeRules",
    "toolVersions",
    "inputs",
    "outputs",
    "counts",
    "unresolved"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "solution": { "type": "string", "minLength": 1 },
    "sourceRevision": { "type": "string", "minLength": 1 },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "includeRules": { "type": "array", "items": { "type": "string" } },
    "excludeRules": { "type": "array", "items": { "type": "string" } },
    "toolVersions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "inputs": { "$ref": "#/$defs/hashedPaths" },
    "outputs": { "$ref": "#/$defs/hashedPaths" },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "unresolved": { "type": "array", "items": { "type": "string" } },
    "parentManifest": { "type": ["string", "null"] }
  },
  "$defs": {
    "hashedPaths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
        }
      }
    }
  }
}
