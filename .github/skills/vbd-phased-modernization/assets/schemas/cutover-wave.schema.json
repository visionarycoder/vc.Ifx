{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/vbd/cutover-wave.schema.json",
  "title": "VBD Cutover Wave Readiness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "useCases",
    "coexistencePattern",
    "dataMigration",
    "gates",
    "rollback",
    "readiness",
    "decommission"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^CUT-[A-Za-z0-9-]+-[0-9]+$" },
    "useCases": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^UC-" },
      "uniqueItems": true
    },
    "coexistencePattern": {
      "enum": [
        "feature-flag",
        "shadow",
        "canary",
        "dual-read",
        "dual-write",
        "event-replication"
      ]
    },
    "dataMigration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "backfillPlan", "reconciliationPlan", "rollbackLimit"],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "backfillPlan": { "type": "string", "minLength": 1 },
        "reconciliationPlan": { "type": "string", "minLength": 1 },
        "rollbackLimit": { "type": "string", "minLength": 1 }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "evidence"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail", "pending"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "procedure", "windowHours"],
      "properties": {
        "trigger": { "type": "string", "minLength": 1 },
        "procedure": { "type": "string", "minLength": 1 },
        "windowHours": { "type": "number", "minimum": 0 }
      }
    },
    "readiness": { "enum": ["ready", "ready-with-approved-risks", "not-ready"] },
    "decommission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheduledAfterUtc", "checklist"],
      "properties": {
        "scheduledAfterUtc": { "type": ["string", "null"], "format": "date-time" },
        "checklist": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
