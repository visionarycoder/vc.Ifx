{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/vbd/operational-contract.schema.json",
  "title": "VBD Operational Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "componentId", "currentVersion", "supportedVersions", "compatibilityTests", "telemetry", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^OPS-[A-Za-z0-9-]+-[0-9]+$" },
    "componentId": { "type": "string", "pattern": "^CMP-" },
    "currentVersion": { "type": "string", "minLength": 1 },
    "supportedVersions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "deprecationDate": { "type": ["string", "null"] },
    "compatibilityTests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentPassed", "previousPassed", "rollbackPassed"],
      "properties": {
        "currentPassed": { "type": "boolean" },
        "previousPassed": { "type": "boolean" },
        "rollbackPassed": { "type": "boolean" }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correlation", "logs", "metrics", "traces", "health", "redaction"],
      "properties": {
        "correlation": { "type": "boolean" },
        "logs": { "type": "boolean" },
        "metrics": { "type": "boolean" },
        "traces": { "type": "boolean" },
        "health": { "type": "boolean" },
        "redaction": { "type": "boolean" }
      }
    },
    "status": { "enum": ["compliant", "non-compliant", "deprecated"] }
  }
}
