{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/vbd/construction-checkpoint.schema.json",
  "title": "VBD Construction Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "phase",
    "createdAtUtc",
    "sourceRevision",
    "evidenceManifestHash",
    "completedOutputs",
    "invalidatedOutputs",
    "unresolvedDecisions",
    "nextReadyTasks",
    "tokenBudget",
    "validationEvidence"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^CP-[A-Za-z0-9-]+-[0-9]+$" },
    "phase": { "type": "string", "minLength": 1 },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "sourceRevision": { "type": "string", "minLength": 1 },
    "evidenceManifestHash": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" },
    "selectedCandidateHash": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" },
    "completedOutputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "validation"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "validation": { "type": "string" }
        }
      }
    },
    "invalidatedOutputs": { "$ref": "#/$defs/stringArray" },
    "unresolvedDecisions": { "$ref": "#/$defs/stringArray" },
    "nextReadyTasks": {
      "type": "array",
      "items": { "type": "string", "pattern": "^TASK-" },
      "uniqueItems": true
    },
    "tokenBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumed", "remaining"],
      "properties": {
        "consumed": { "type": "integer", "minimum": 0 },
        "remaining": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "validationEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "status", "detail"],
        "properties": {
          "check": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "warn", "fail", "skip"] },
          "detail": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  }
}
