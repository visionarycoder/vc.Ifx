{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/vbd/use-case.schema.json",
  "title": "VBD Use Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "actor",
    "trigger",
    "preconditions",
    "outcome",
    "mainFlow",
    "alternateFlows",
    "failureFlows",
    "supportingSymbols",
    "gaps",
    "conflicts",
    "confidence"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^UC-[A-Za-z0-9-]+-[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "trigger": { "type": "string", "minLength": 1 },
    "preconditions": { "$ref": "#/$defs/stringArray" },
    "outcome": { "type": "string", "minLength": 1 },
    "mainFlow": { "$ref": "#/$defs/nonEmptyStringArray" },
    "alternateFlows": { "$ref": "#/$defs/stringArray" },
    "failureFlows": { "$ref": "#/$defs/stringArray" },
    "authorization": { "$ref": "#/$defs/stringArray" },
    "data": { "$ref": "#/$defs/stringArray" },
    "transactionBoundary": { "type": "string" },
    "nonfunctionalRequirements": { "$ref": "#/$defs/stringArray" },
    "supportingSymbols": {
      "type": "array",
      "items": { "type": "string", "pattern": "^SYM-" },
      "uniqueItems": true
    },
    "gaps": { "$ref": "#/$defs/stringArray" },
    "conflicts": { "$ref": "#/$defs/stringArray" },
    "confidence": { "enum": ["high", "medium", "low"] }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
