{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/vbd/architecture-conformance-report.schema.json",
  "title": "VBD Architecture Conformance Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "createdAtUtc", "rules", "providers", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^CONF-[A-Za-z0-9-]+-[0-9]+$" },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "status", "evidence", "owner"],
        "properties": {
          "ruleId": { "type": "string", "pattern": "^ARCH-[0-9]{3}$" },
          "status": { "enum": ["pass", "fail", "waived"] },
          "evidence": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "waiverExpiresUtc": { "type": ["string", "null"], "format": "date-time" },
          "waiverRationale": { "type": ["string", "null"] }
        }
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "status", "failedTests"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["in-memory", "durable"] },
          "status": { "enum": ["pass", "fail"] },
          "failedTests": { "$ref": "#/$defs/stringArray" }
        }
      }
    },
    "status": { "enum": ["conformant", "conformant-with-waivers", "non-conformant"] }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  }
}
