<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Official NuGet feed -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />

    <!-- Single shared local package output (see Directory.Build.props PackageOutputPath).
         Every packable project in this repo packs here. Other solutions on this machine can
         reference these packages by adding the same folder as a source; see the "Local
         package feed" section of README.md for the exact command. -->
    <add key="Ifx-Local" value=".nupkgs" />

    <!-- GitHub Packages feed (commented out until needed) -->
    <!-- <add key="github" value="https://nuget.pkg.github.com/OWNER/index.json" /> -->
  </packageSources>

  <!-- Package source credentials (commented out until GitHub packages are needed) -->
  <!--
  <packageSourceCredentials>
    <github>
      <add key="Username" value="OWNER" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github>
  </packageSourceCredentials>
  -->
</configuration>