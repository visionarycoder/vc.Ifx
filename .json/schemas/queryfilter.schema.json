{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/visionarycoder/vc.Ifx/schemas/queryfilter-v1.json",
  "title": "QueryFilter",
  "description": "Version 1 structural query filter. Runtime member types are checked during rehydration.",
  "$ref": "#/$defs/filter",
  "$defs": {
    "filter": {
      "oneOf": [
        {
          "$ref": "#/$defs/property"
        },
        {
          "$ref": "#/$defs/composite"
        },
        {
          "$ref": "#/$defs/not"
        }
      ]
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "property"
      ],
      "properties": {
        "operator": {
          "enum": [
            "Equals",
            "NotEquals",
            "GreaterThan",
            "GreaterThanOrEqual",
            "LessThan",
            "LessThanOrEqual",
            "Contains",
            "StartsWith",
            "EndsWith",
            "In",
            "NotIn"
          ]
        },
        "property": {
          "type": "string",
          "pattern": "\\S"
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "ignoreCase": {
          "type": "boolean"
        }
      }
    },
    "composite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "children"
      ],
      "properties": {
        "operator": {
          "enum": [
            "And",
            "Or"
          ]
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/filter"
          }
        }
      }
    },
    "not": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "children"
      ],
      "properties": {
        "operator": {
          "const": "Not"
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/filter"
          }
        }
      }
    }
  }
}
